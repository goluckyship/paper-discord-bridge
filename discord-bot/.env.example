# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your-bot-token-here

# Application (client) ID of your Discord app, used to register slash commands
CLIENT_ID=your-app-client-id

# Guild ID to register commands in instantly (optional; leave blank for global)
GUILD_ID=

# Port the bot's HTTP server listens on (the plugin posts join/leave events here)
BOT_HTTP_PORT=8080

# Base URL of the Paper plugin's HTTP API (the bot queries this for players + count)
PLUGIN_API_URL=http://localhost:8787

# Shared secret. MUST match the plugin's auth-token.
AUTH_TOKEN=changeme

# Channel ID where join/leave messages are posted
EVENT_CHANNEL_ID=

# Optional: voice channel ID whose name is updated with the live player count
PLAYER_COUNT_CHANNEL_ID=
